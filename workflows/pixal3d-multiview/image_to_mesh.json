        0
      ],
      "negative": [
        "conditioning",
        1
      ],
      "latent_image": [
        "structure_latent",
        0
      ],
      "seed": 56,
      "steps": 12,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "structure_decode": {
    "class_type": "VaeDecodeStructureTrellis2",
